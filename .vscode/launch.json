{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run server",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceRoot}/code/compiled/main",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Compile main.cpp",
      "args": [
        "--listen",
        "5050"

      ]
    },
     {
      "name": "Run client",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceRoot}/code/compiled/main",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Compile main.cpp",
      "args": [
        "--connect",
        "127.0.0.1",
        "5050"

      ]
    },
  ]
}